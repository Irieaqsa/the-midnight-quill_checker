# ======================
# Server
# ======================
PORT=4000
NODE_ENV=development

# ======================
# Database
# ======================
DATABASE_URL="file:./dev.db"

# ======================
# JWT
# ======================
JWT_SECRET=super-secret-change-me-in-production
JWT_REFRESH_SECRET=another-secret-change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ======================
# Redis (optional for dev)
# ======================
REDIS_URL=redis://localhost:6379

# ======================
# CORS
# ======================
CORS_ORIGIN=http://localhost:5173

# ======================
# Email (SMTP)
# ======================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="TMQ Authenticity Desk <noreply@tmq.com>"

# ======================
# WhatsApp Business Cloud API
# ======================
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_VERIFY_TOKEN=your-verify-token

# ======================
# AI Detection Provider API Keys
# ======================
GPTZERO_API_KEY=
COPYLEAKS_API_KEY=
COPYLEAKS_EMAIL=
SAPLING_API_KEY=
ORIGINALITY_API_KEY=
WINSTON_API_KEY=

# ======================
# Google OAuth
# ======================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ======================
# PDF Storage
# ======================
PDF_STORAGE_PATH=./storage/reports

# ======================
# Rate Limiting
# ======================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ======================
# Use mock detectors (set to true for dev without API keys)
# ======================
USE_MOCK_DETECTORS=true
